# Salin menjadi ".env" untuk uji LOKAL. Di VERCEL jangan pakai file ini:
# isi semua nilai di Project > Settings > Environment Variables (lihat PANDUAN_VERCEL.md).
# JANGAN upload file .env ke GitHub.

# ---- Umum ----
PORT=3000
# Alamat publik toko. Di Vercel boleh dikosongkan (otomatis memakai domain yang sedang dibuka).
BASE_URL=
# Vercel mengisi "production" otomatis. Lokal biarkan development (ada mode simulasi bayar).
NODE_ENV=development
# Nomor WhatsApp toko format 62 (tanpa + atau 0 di depan)
STORE_WHATSAPP=6285385490505

# ---- Database (Turso) ----
# WAJIB di Vercel. Kosong = lokal memakai file local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Keamanan (WAJIB di Vercel) ----
# Teks acak >= 32 karakter: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Rahasia untuk Vercel Cron (pembersihan pesanan kedaluwarsa). Isi teks acak apa saja, di Vercel.
CRON_SECRET=

# ---- Midtrans ----
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# false = Sandbox (uji coba) | true = Production (UANG ASLI)
MIDTRANS_IS_PRODUCTION=false
PAYMENT_WINDOW_MINUTES=180

# ---- Login Google (opsional) ----
GOOGLE_CLIENT_ID=

# ---- Notifikasi Telegram (opsional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pesanan 'Dikirim' otomatis 'Selesai' setelah N hari
AUTO_COMPLETE_DAYS=7
